# Copy to .env (same folder) and fill in. .env is git-ignored.

SERVER_PORT=8080

# Database
DB_URL=jdbc:mysql://localhost:3307/hotel_shivar?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=root

# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Staff/admin endpoints require header:  X-Admin-Key: <this value>
# Leave empty to lock admin endpoints entirely. Generate one with e.g.  openssl rand -hex 32
ADMIN_API_KEY=change-me-to-a-long-random-string

# Email notifications (auto-reply to guest + alert to hotel)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
# For Gmail use an App Password, not the account password
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=stay@hotelshivar.com
MAIL_ADMIN_TO=stay@hotelshivar.com
