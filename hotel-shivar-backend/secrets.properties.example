# Copy this file to "secrets.properties" (same folder) and fill in your Razorpay keys.
# secrets.properties is in .gitignore - it is never committed or pushed. Do not put keys in any other file.
#
# Razorpay Dashboard -> Account & Settings -> API Keys. Use the Test Mode keys (rzp_test_...) while testing,
# and the Live Mode keys (rzp_live_...) only on the real server.
app.razorpay.key-id=rzp_test_xxxxxxxxxxxxxx
app.razorpay.key-secret=your_key_secret_here
#
# Optional, recommended: Dashboard -> Webhooks -> Add new webhook
#   URL:    https://<your-backend-domain>/api/payments/razorpay/webhook
#   Events: payment.captured, payment.failed
#   Secret: any long random text - put the same text here
app.razorpay.webhook-secret=
